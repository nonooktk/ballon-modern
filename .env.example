# キー名のみ（値は空）。実値は Azure のアプリ設定と、ローカルの .env（コミット禁止）。
# 接続文字列・トークンは秘匿値。リポジトリ・ログ・Slack に出さない。

# --- API（app/backend）---
# ロール ballon_api の接続文字列（Azure のアプリ設定）
DATABASE_URL=
# Google の OAuth クライアント ID（秘匿値ではない。API の aud 検証に使う）
GOOGLE_CLIENT_ID=
# 画面の URL（カンマ区切り）。ローカルは http://localhost:3000
ALLOWED_ORIGINS=
# レート制限と上限（暫定値は ARCHITECTURE.md §8・U8。値は T1 が決める）
RATE_LIMIT_WRITE_PER_SEC=
RATE_LIMIT_WRITE_PER_MIN=
RATE_LIMIT_REPEATABLE_PER_DAY=
RATE_LIMIT_LEDGER_PER_DAY=

# --- 画面（app/frontend）。ビルド時に埋め込まれる。秘匿値ではない ---
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
