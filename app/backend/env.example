# API の環境変数の例。値は空にしてあります。.env は作ってもコミットしません（Azure ではアプリ設定に登録します）。

# ballon_api ロールの接続文字列（秘匿値）。関数の実行だけができるロール。管理用ロールの接続文字列は入れない
DATABASE_URL=

# Google の OAuth クライアント ID（ID トークンの aud 検証に使う。秘匿値ではない）
GOOGLE_CLIENT_ID=

# 許可する画面の URL（カンマ区切り）。例: https://app-ballon-web-nonooktk.azurewebsites.net,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# 未設定なら production として扱う（開発時だけ明示的に development にする）。production では DEV_AUTH_BYPASS は無効、/docs も出ない
APP_ENV=development

# 開発用: 1 のときだけ `Authorization: Bearer dev:<任意の sub>` を受け付ける（Google の検証を通さない。本番では使わない）
DEV_AUTH_BYPASS=

# 任意: DB の接続プールの最大数（既定 5。PostgreSQL B1ms の接続数の上限を考えて小さく）
DB_POOL_MAX=

# 任意: 頻度制限（既定 書き込み 1 秒 20 回・1 分 300 回、読み取り 1 分 120 回、認証失敗 1 IP あたり 1 分 60 回）
RATE_WRITE_PER_SEC=
RATE_WRITE_PER_MIN=
RATE_READ_PER_MIN=
RATE_AUTH_FAIL_PER_MIN=
