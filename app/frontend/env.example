# コピーして .env.local を作る（.env.local はコミットされない）
# NEXT_PUBLIC_* はビルド時に埋め込まれる。秘匿値は入れない。
# API の場所（CI・配備はこちらの名前。NEXT_PUBLIC_API_BASE でも読める）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Google Identity Services のクライアント ID（秘匿値ではない）
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 1 のときだけ「開発ログイン」を出す（API 側は DEV_AUTH_BYPASS が必要）。本番では設定しない
NEXT_PUBLIC_DEV_AUTH=
# 1 のとき API の代わりに画面内のモックで動く（npm run dev:mock が設定する）。本番では設定しない
NEXT_PUBLIC_MOCK=
